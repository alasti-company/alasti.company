{
  "name": "alasti.company",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc && vp build",
    "preview": "vp preview",
    "prepare": "vp config"
  },
  "dependencies": {
    "onedollarstats": "^0.0.19",
    "wrangler": "^4.156.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "typescript": "~6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "overrides": {
      "vite@*": "npm:@voidzero-dev/vite-plus-core@1.4.0",
      "vitest@*": "5.0.5"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "@cloudflare/vite-plugin>vite": "1.4.0",
        "@vitest/mocker>vite": "1.4.0",
        "vitest>vite": "1.4.0"
      }
    }
  }
}
