{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alasti-company",
  "compatibility_date": "2026-05-07",
  "build": {
    "watch_dir": "./src",
    "command": "pnpm run build",
  },
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
  },
  "workers_dev": false,
  "routes": [
    {
      "enabled": true,
      "custom_domain": true,
      "pattern": "alasti.company",
    },
  ],
}
